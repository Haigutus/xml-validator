      <Period>
        <timeInterval>2021-10-14T03:00Z/2021-10-14T04:00Z</timeInterval>  <!-- Transfer of gas stock is valid at the end of the time interval provided-->
        <quantity.amount>1000000</quantity.amount>
      </Period>
    </Transaction> 
      <Transaction>
      <identification>identification2</identification> <!-- Optional -->
      <transactionCode>ZTJ</transactionCode> <!-- Transfer of inventory capacity -->
      <measureUnit.unitOfMeasureCode>KW2</measureUnit.unitOfMeasureCode>
      <Period>
        <timeInterval>2021-10-14T04:00Z/2021-11-01T05:00Z</timeInterval>  <!-- Transfer of inventory capacity for the gas days in the given period-->
        <quantity.amount>30000</quantity.amount>
      </Period>
    </Transaction> 
  </ConnectionPoint>  
