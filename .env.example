# Copy to .env and edit. .env is gitignored and not copied into images.
#   cp .env.example .env
#
# These are local *config* values, not GitHub Actions secrets.
# CI uses repo Variables + WIF (see .github/workflows/).
# Prefer: gcloud auth login  (no tokens in files)

# --- Local app / container ---
HOST_PORT=8030
CONTAINER_NAME=xml-validator
LOCAL_IMAGE=xml-validator:latest

# --- GCP (local helper scripts only; optional if gcloud config is set) ---
GCP_PROJECT=xml-validator-cimtools
GCP_REGION=europe-west1
SERVICE_NAME=xml-validator-cimtools
AR_REPO=xml-validator-cimtools

# Optional custom domain mapping after deploy
# DOMAIN=xsd.cimtools.eu

# Free-tier-ish Cloud Run sizing (local deploy script)
# MEMORY=512Mi
# CPU=1
# MAX_INSTANCES=2
# CONCURRENCY=40
# TIMEOUT=60
