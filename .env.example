# Copy to .env and fill in YOUR values. .env is gitignored and never baked into images.
#   cp .env.example .env
#
# Local only. Production CI reads the same names from GitHub Actions Variables
# (and optional Secrets) — see README "Deploy your own".
#
# Do NOT put long-lived keys/tokens here. Use:
#   local:  gcloud auth login
#   CI:     Workload Identity Federation (GCP_WORKLOAD_IDENTITY_PROVIDER + SA)

# --- Local app / container ---
HOST_PORT=8030
CONTAINER_NAME=xml-validator
LOCAL_IMAGE=xml-validator:latest

# --- GCP (required for make deploy / scripts/deploy-cloudrun.sh) ---
GCP_PROJECT=
GCP_REGION=europe-west1
SERVICE_NAME=xml-validator
AR_REPO=xml-validator
# Image name in AR (defaults to SERVICE_NAME)
# IMAGE_NAME=xml-validator

# Optional: create/update Cloud Run domain mapping after local deploy
# DOMAIN=validator.example.com

# Free-tier-ish Cloud Run sizing (optional overrides)
# MEMORY=512Mi
# CPU=1
# MAX_INSTANCES=2
# CONCURRENCY=40
# TIMEOUT=60
